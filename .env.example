# Public browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-only values. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional modern Supabase server key name (takes precedence when set).
SUPABASE_SECRET_KEY=
CRON_SECRET=generate-a-long-random-secret

# One-time initial owner setup used by npm run seed.
INITIAL_OWNER_EMAIL=owner@yourcompany.com
INITIAL_OWNER_PASSWORD=use-a-unique-password-with-12-or-more-characters
INITIAL_OWNER_NAME=Evergreen Water Owner

# Optional messaging integration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
